---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../../lib/utils";

interface Props extends HTMLAttributes<"header"> {
  title: string;
  subtitle?: string;
  badge?: string;
  align?: "left" | "center";
}

const {
  title,
  subtitle,
  badge,
  align = "left",
  class: className,
  ...props
} = Astro.props;
---

<header
  class={cn(
    "flex flex-col gap-2",
    align === "center" ? "items-center text-center" : "items-start",
    className
  )}
  {...props}
>
  {
    badge && (
      <span class="inline-flex items-center rounded-[2px] bg-brand-8 px-2 py-0.5 text-xs font-paper text-brand-base ring-1 ring-inset ring-brand-20 mb-1">
        {badge}
      </span>
    )
  }
  <h2
    class="text-[1.75rem]/8 font-medium tracking-[-0.72px] lg:text-[2.25rem]/[2.5rem] text-foreground-primary"
  >
    {title}
    {
      subtitle && (
        <span class="block text-foreground-tertiary text-lg lg:text-xl font-normal tracking-normal mt-1.5">
          {subtitle}
        </span>
      )
    }
  </h2>
</header>
