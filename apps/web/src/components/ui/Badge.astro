---
import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../../lib/utils";

const badgeVariants = cva(
  "inline-flex items-center rounded-[2px] px-1.5 py-0.5 text-xs font-paper transition-colors select-none",
  {
    variants: {
      variant: {
        brand: "bg-brand-8 text-brand-base ring-1 ring-inset ring-brand-20",
        secondary:
          "bg-background-tertiary text-foreground-secondary ring-1 ring-inset ring-border-secondary",
        outline:
          "bg-background-transparent text-foreground-tertiary ring-1 ring-inset ring-border-line",
      },
    },
    defaultVariants: {
      variant: "brand",
    },
  }
);

interface Props
  extends HTMLAttributes<"span">,
    VariantProps<typeof badgeVariants> {}

const { variant, class: className, ...props } = Astro.props;
---

<span
  data-slot="badge"
  class={cn(badgeVariants({ variant }), className)}
  {...props}
>
  <slot />
</span>
