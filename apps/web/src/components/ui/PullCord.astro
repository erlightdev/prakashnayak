  .pc2 {
    position: relative;
    width: 0;
    height: 0;
  }

  .pc2-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform: scale(var(--pc2-k, 0.85));
    transform-origin: 0 0;
  }

  .pc2-rig {
    z-index: 4;
  }

  .pc2-cord {
    position: absolute;
    left: -240px;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }

  .pc2-cord path {
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pc2-cord-line {
    stroke: var(--foreground-secondary, #302a26);
    transition: stroke 0.3s ease;
  }

  .pc2-cord-lit {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  :global(.dark) .pc2-cord-lit {
    opacity: 0.85;
  }

  .pc2-plush {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.18));
  }

  :global(.dark) .pc2-plush {
    filter: drop-shadow(0 8px 24px rgba(24, 226, 153, 0.25)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
  }

  .pc2-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .pc2-part {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
  }

  .pc2-ear {
    will-change: transform;
  }

  .pc2-phos {
    opacity: 0;
    transition: opacity 0.4s ease;
    mix-blend-mode: screen;
  }

  :global(.dark) .pc2-phos {
    opacity: 0.85;
  }

  .pc2-knot {
    position: absolute;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--brand-button-border, #04422b);
    transition: background-color 0.45s ease;
  }

  :global(.dark) .pc2-knot {
    background: #18e299;
  }

  .pc2-eye {
    transform-box: fill-box;
