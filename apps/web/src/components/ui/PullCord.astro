<script>
  import { playConfirmSound } from "../../lib/sound";

  function initPullCordV2() {
    const root = document.getElementById("pc2-root");
    const cordPath = document.getElementById("pc2-cord-path") as SVGPathElement | null;
    const cordLitPath = document.getElementById("pc2-cord-lit-path") as SVGPathElement | null;
    const plushEl = document.getElementById("pc2-plush") as HTMLElement | null;
    const knobBtn = document.getElementById("pc2-knob-btn") as HTMLButtonElement | null;
    const ears = root?.querySelectorAll<SVGElement>(".pc2-ear");

    if (!root || !cordPath || !cordLitPath || !plushEl || !knobBtn) return;

    // Core Constants from V2
    const Zs = 230; // cord rest length
    const NUM_SEGMENTS = 16;
    const REST_SEG = Zs / NUM_SEGMENTS; // 14.375
    const ou = 68.7; // knot anchor X
    const g0 = 1.2;  // knot anchor Y
    const RAD_TO_DEG = 180 / Math.PI;

    // Physics parameters
    const gravity = 1200;
    const damping = 0.94;
    const iterations = 18;
    const stretchMax = 65;
    const stretchToggle = 42;
    const maxVelocity = 28;

    type Node = { x: number; y: number; ox: number; oy: number; fixed: boolean };

    function makeNodes(): Node[] {
      const arr: Node[] = [];
      for (let i = 0; i <= NUM_SEGMENTS; i++) {
        const y = REST_SEG * i;
        arr.push({ x: 0, y, ox: 0, oy: y, fixed: i === 0 });
      }
      return arr;
    }

    function buildPath(pts: Node[]): string {
      let d = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const xc = (pts[i].x + pts[i + 1].x) / 2;
        const yc = (pts[i].y + pts[i + 1].y) / 2;
        d += ` Q ${pts[i].x.toFixed(1)} ${pts[i].y.toFixed(1)} ${xc.toFixed(1)} ${yc.toFixed(1)}`;
      }
      const last = pts.length - 1;
      d += ` L ${pts[last].x.toFixed(1)} ${pts[last].y.toFixed(1)}`;
      return d;
    }

    const pts = makeNodes();
    const last = pts.length - 1;

    let dragging = false;
    let didDrag = false;
    let clicked = false;
    let dragStartX = 0;
    let dragStartY = 0;
    const target = { x: 0, y: Zs };

    // Dynamic rotation & ear spring variables
    let rot = 0;
    let rotVel = 0;
    let earR = 0;
    let earRVel = 0;
    let earL = 0;
    let earLVel = 0;
    let prevVertVel = 0;
    let vertAcc = 0;
    let scaleY = 1;
    let scaleVel = 0;

    let rafId = 0;
    let running = false;
    let prevT = 0;
    let prevDt = 0;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function render() {
      const d = buildPath(pts);
      cordPath!.setAttribute("d", d);
      cordLitPath!.setAttribute("d", d);

      const p = pts[last];
      const scaleX = 1 / Math.sqrt(Math.max(0.7, scaleY));
      plushEl!.style.transform = `translate(${(p.x - ou).toFixed(2)}px, ${(p.y - g0).toFixed(2)}px) rotate(${rot.toFixed(2)}deg) scale(${scaleX.toFixed(4)}, ${scaleY.toFixed(4)})`;

      if (ears) {
        ears.forEach((ear) => {
          const isRight = ear.dataset.ear === "R";
          const skewVal = isRight ? -earR : -earL;
          ear.style.transform = `skewX(${skewVal.toFixed(2)}deg)`;
        });
      }
    }

    function step(now: number) {
      const dt = prevT ? Math.min(0.04, Math.max(0.004, (now - prevT) / 1000)) : 1 / 60;
      prevT = now;
      const tc = prevDt > 0 ? dt / prevDt : 1;
      const velCoef = Math.pow(damping, dt * 60) * tc;
      const accCoef = dt * dt;

      // Verlet update on rope
      for (let i = 1; i <= last; i++) {
        const p = pts[i];
        if (p.fixed) continue;
        const vx = p.x - p.ox;
        const vy = p.y - p.oy;
        p.ox = p.x;
        p.oy = p.y;
        p.x += vx * velCoef;
        p.y += vy * velCoef + gravity * accCoef;
      }

      pts[0].x = 0;
      pts[0].y = 0;

      if (dragging) {
        pts[last].ox = pts[last].x;
        pts[last].oy = pts[last].y;
        pts[last].x = target.x;
        pts[last].y = target.y;
      }

      // Distance constraints
      for (let k = 0; k < iterations; k++) {
        for (let i = 0; i < last; i++) {
          const a = pts[i];
          const b = pts[i + 1];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.hypot(dx, dy) || 0.0001;
          const diff = ((REST_SEG - dist) / dist) * 0.5;
          const ox = dx * diff;
          const oy = dy * diff;
          if (!a.fixed) {
            a.x -= ox;
            a.y -= oy;
          }
          if (!b.fixed) {
            b.x += ox;
            b.y += oy;
          }
        }
      }

      prevDt = dt;

      // Plushie angular spring physics based on rope end inclination
      const pLast = pts[last];
      const pPrev = pts[Math.max(0, last - 2)];
      const targetAngle = Math.atan2(-(pLast.x - pPrev.x), pLast.y - pPrev.y) * RAD_TO_DEG;
      const springAcc = 140 * (targetAngle - rot) - 11 * rotVel;
      rotVel += springAcc * dt;
      rot += rotVel * dt;

      // Vertical acceleration for ear & squash reaction
      const currentVertVel = (pLast.y - pLast.oy) / dt;
      const rawVertAcc = (currentVertVel - prevVertVel) / dt;
      vertAcc += (Math.max(-25000, Math.min(25000, rawVertAcc)) - vertAcc) * 0.5;
      prevVertVel = currentVertVel;

      // Ear inertia
      const earRForce = -70 * earR - 5.5 * earRVel - springAcc * 0.7 - vertAcc * 0.14;
      const earLForce = -70 * earL - 5.5 * earLVel - springAcc * 0.7 + vertAcc * 0.14;
      earRVel += earRForce * dt;
      earLVel += earLForce * dt;
      earR = Math.max(-6, Math.min(18, earR + earRVel * dt));
      earL = Math.max(-18, Math.min(6, earL + earLVel * dt));

      // Elastic squash-and-stretch volume preservation
      const ropeStretch = Math.hypot(pLast.x, pLast.y) - Zs;
      const targetSquash = dragging ? 1 + 0.07 * Math.max(0, Math.min(1, ropeStretch / stretchMax)) : 1;
      scaleVel += (400 * (targetSquash - scaleY) - 14 * scaleVel - vertAcc * 0.0024) * dt;
      scaleY = Math.max(0.9, Math.min(1.14, scaleY + scaleVel * dt));

      render();

      // Check resting threshold
      let totalMotion = 0;
      for (let i = 1; i <= last; i++) {
        totalMotion += Math.abs(pts[i].x - pts[i].ox) + Math.abs(pts[i].y - pts[i].oy);
      }

      const isResting =
        totalMotion < 0.2 * dt * 60 &&
        Math.abs(rotVel) < 0.3 &&
        Math.abs(targetAngle - rot) < 0.1 &&
        Math.abs(earRVel) + Math.abs(earLVel) < 0.3 &&
        Math.abs(scaleY - 1) < 0.002;

      if (!dragging && isResting) {
        running = false;
        return;
      }

      rafId = requestAnimationFrame(step);
    }

    function wake() {
      if (running) return;
      running = true;
      prevT = 0;
      prevDt = 0;
      rafId = requestAnimationFrame(step);
    }

    function toggleTheme() {
      playConfirmSound();
      root?.classList.add("is-touched");

      const isDark = document.documentElement.classList.contains("dark");
      const nextDark = !isDark;
      if (nextDark) {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      } else {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      }

      knobBtn?.setAttribute("aria-pressed", nextDark ? "true" : "false");
    }

    function scriptedPull() {
      toggleTheme();
      if (reduce) return;
      pts[last].oy -= 30; // tactile recoil
      wake();
    }

    // Pointer event interaction
    knobBtn.addEventListener("pointerdown", (e) => {
      if (reduce) return;
      knobBtn.setPointerCapture(e.pointerId);
      root?.classList.add("is-touched");
      dragging = true;
      didDrag = true;
      clicked = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      wake();
    });

    knobBtn.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const k = 0.85; // match scale
      const dx = (e.clientX - dragStartX) / k;
      const dy = (e.clientY - dragStartY) / k;

      const rx = dx;
      const ry = Zs + dy;
      const dist = Math.hypot(rx, ry) || 0.0001;
      const maxD = Zs + stretchMax;
      const factor = dist > maxD ? maxD / dist : 1;

      target.x = rx * factor;
      target.y = ry * factor;

      if (!clicked && dist - Zs >= stretchToggle) {
        clicked = true;
        toggleTheme();
      }
    });

    function onPointerUp(e: PointerEvent) {
      if (!dragging) return;
      try {
        knobBtn?.releasePointerCapture(e.pointerId);
      } catch {}
      dragging = false;

      const p = pts[last];
      const vx = p.x - p.ox;
      const vy = p.y - p.oy;
      const v = Math.hypot(vx, vy);
      if (v > maxVelocity) {
        const k = maxVelocity / v;
        p.ox = p.x - vx * k;
        p.oy = p.y - vy * k;
      }

      wake();
      requestAnimationFrame(() => {
        didDrag = false;
      });
    }

    knobBtn.addEventListener("pointerup", onPointerUp);
    knobBtn.addEventListener("pointercancel", onPointerUp);

    // Click & Keyboard triggers
    knobBtn.addEventListener("click", (e) => {
      if (didDrag) return;
      if (e.detail === 0) return;
      scriptedPull();
    });

    knobBtn.addEventListener("keydown", (e) => {
      if ((e.key === "Enter" || e.key === " ") && !e.repeat) {
        e.preventDefault();
        scriptedPull();
      }
    });

    // Cleanup on visibilitychange
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && running) {
        cancelAnimationFrame(rafId);
        running = false;
      }
    });

    // Initial render & gentle initial bounce
    render();
    setTimeout(() => {
      if (!reduce) {
        pts[last].oy -= 14;
        pts[last].ox -= 6;
        wake();
      }
    }, 400);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPullCordV2);
  } else {
    initPullCordV2();
  }
</script>
