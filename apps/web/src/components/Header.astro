---
const links = [
  { to: "/", label: "Home" },
  { to: "#about", label: "About" },
  { to: "#projects", label: "Projects" },
  { to: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 bg-background-primary/90 backdrop-blur-sm" data-line>
  <div class="flex items-center justify-between px-4 py-3 md:px-8">
    <div class="flex items-center gap-6">
      <a
        href="/"
        class="font-mono text-sm font-semibold tracking-tight text-foreground-primary outline-none focus-visible:ring-2 focus-visible:ring-brand-base focus-visible:ring-offset-2 focus-visible:ring-offset-background-primary rounded-[2px]"
      >
        pn<span class="text-brand-base">.</span>
      </a>
      <nav class="flex items-center gap-5 text-sm">
        {links.map((link) => (
          <a
            href={link.to}
            class="text-foreground-secondary hover:text-foreground-primary transition-colors duration-150 ease-[var(--ease-out-soft)] outline-none focus-visible:ring-2 focus-visible:ring-brand-base focus-visible:ring-offset-2 focus-visible:ring-offset-background-primary rounded-[2px]"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
