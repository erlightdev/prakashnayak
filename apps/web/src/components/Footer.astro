---
import { mailto, profile } from "../data/profile";

const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: "WORK",
    links: [
      { name: "Projects", href: "#projects" },
      { name: "Experiments", href: "#" },
      { name: "Bookmarks", href: "#" },
    ],
  },
  {
    title: "CONNECT",
    links: [
      { name: "Email", href: mailto },
      { name: "LinkedIn", href: profile.linkedin },
      { name: "GitHub", href: profile.github },
      { name: "ResearchGate", href: profile.researchgate },
    ],
  },
  {
    title: "ABOUT",
    links: [
      { name: "Resume", href: "#" },
      { name: "Blog", href: "#" },
    ],
  },
];
---

<footer class="m-1 relative overflow-hidden rounded-2xl bg-background-secondary border border-border-line">
  <div class="px-6 py-12 md:px-12 md:py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      {/* Brand & Description */}
      <div class="md:col-span-4 flex flex-col gap-4">
        <a
          href="/"
          class="font-mono text-xl font-semibold tracking-tight text-foreground-primary inline-flex items-center outline-none focus-visible:ring-2 focus-visible:ring-brand-base rounded-[2px]"
        >
          pn<span class="text-brand-base">.</span>
        </a>
        <p class="text-sm text-foreground-secondary leading-relaxed max-w-xs">
          Crafting modern, accessible, and performant web experiences.
        </p>
      </div>

      {/* Links Grid */}
      <div class="md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-8">
        {
          footerLinks.map((section) => (
            <div class="flex flex-col gap-4">
              <h3 class="text-xs font-semibold tracking-wider text-foreground-tertiary uppercase">
                {section.title}
              </h3>
              <ul class="flex flex-col gap-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...(link.href.startsWith("http") && {
                        target: "_blank",
                        rel: "noopener noreferrer",
                      })}
                      class="text-sm text-foreground-secondary hover:text-foreground-primary transition-colors duration-150 ease-[var(--ease-out-soft)] outline-none focus-visible:ring-2 focus-visible:ring-brand-base rounded-[2px]"
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {/* Divider */}
    <div class="h-px w-full bg-border-line my-8 md:my-12"></div>

    {/* Bottom Footer */}
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs sm:text-sm text-foreground-tertiary">
      <p>&copy; {currentYear} Prakash Nayak. All rights reserved.</p>
      <p>Thoughtfully made. Ready for what's next.</p>
    </div>
  </div>

  {/* Large Background Text */}
  <div
    class="absolute bottom-0 left-0 w-full flex justify-center pointer-events-none select-none z-0 overflow-hidden"
    style="transform: translateY(35%);"
  >
    <span
      class="text-[20vw] leading-none font-bold text-foreground-primary opacity-[0.03] tracking-tighter"
    >
      prakash
    </span>
  </div>
</footer>
