---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ExperienceList from "../components/ExperienceList";
import SkillsTabs from "../components/SkillsTabs";
import EducationAccordion from "../components/EducationAccordion";
import { mailto, whatsapp } from "../data/profile";
import Button from "../components/ui/Button.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Layout
  title="Prakash Nayak — Full-Stack Developer"
  description="Full-stack developer in Patan, Lalitpur building fast, SEO-friendly products with WordPress, React, Laravel and Django."
>
  <Hero />

  <!-- Experience -->
  <section id="experience" class="py-12 md:py-16" data-line>
    <div class="flex items-end justify-between gap-4 px-4 md:px-8 pb-6">
      <SectionHeader title="Professional Experience" subtitle="Where I've built and shipped." />
      <span class="font-mono text-xs text-foreground-tertiary">2018 — now</span>
    </div>
    <div class="border-t border-border-line">
      <ExperienceList client:visible />
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="px-4 md:px-8 py-12 md:py-16" data-line>
    <div class="flex flex-col gap-8">
      <SectionHeader title="Skills" subtitle="Tools I use to design, build and ship." />
      <SkillsTabs client:visible />
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="px-4 md:px-8 py-12 md:py-16" data-line>
    <div class="flex flex-col gap-8">
      <SectionHeader title="Education" subtitle="Where the engineering started." />
      <EducationAccordion client:visible />
    </div>
  </section>

  <!-- Selected Projects -->
  <section id="projects" class="py-12 md:py-16 px-4 md:px-8" data-line>
    <div class="flex flex-col gap-8">
      <SectionHeader title="Selected Projects" subtitle="Live products and sites I've built." />
      <div class="projects-grid grid grid-cols-1 gap-4 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>


  <!-- Contact Section -->
  <section id="contact" class="py-16 px-4 md:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-medium text-foreground-primary tracking-tight">
          Let's connect
        </h3>
        <p class="text-sm text-foreground-secondary mt-1">
          Open to technical advisory, consulting, and engineering roles.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <Button
          variant="primary"
          size="lg"
          href={mailto}
        >
          Send an Email
        </Button>
        <Button
          variant="outline"
          size="lg"
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="h-4 w-4 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          Hire me
        </Button>
      </div>
    </div>
  </section>
</Layout>
